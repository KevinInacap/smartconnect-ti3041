{
  "apidogCli": "1.1",
  "info": {
    "name": "SmartConnect · Acceso residencial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "demoPassword",
      "value": ""
    }
  ],
  "environment": {
    "name": "SmartConnect local",
    "variable": {
      "values": [
        {
          "key": "baseUrl",
          "value": "http://127.0.0.1:8000"
        },
        {
          "key": "demoPassword",
          "value": ""
        }
      ]
    }
  },
  "item": [
    {
      "name": "Acceso de una residente",
      "item": [
        {
          "name": "Viviendas sin sesión",
          "metaInfo": {
            "id": "1",
            "type": "http",
            "name": "Viviendas sin sesión"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "metaInfo": {
            "id": "2",
            "type": "http",
            "name": "Iniciar sesión"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/token/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_vecina\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"access\", pm.response.json().access);",
                  "pm.environment.set(\"refresh\", pm.response.json().refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar sesión",
          "metaInfo": {
            "id": "3",
            "type": "http",
            "name": "Renovar sesión"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/token/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"access\", pm.response.json().access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis viviendas",
          "metaInfo": {
            "id": "4",
            "type": "http",
            "name": "Mis viviendas"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"casa\", pm.response.json().find(v => v.codigo === \"A-01\").id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi rol en A-01",
          "metaInfo": {
            "id": "5",
            "type": "http",
            "name": "Mi rol en A-01"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/{{casa}}/asignaciones/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const vinculo = pm.response.json().find(v => v.rol === \"arrendatario\" && v.vivienda === Number(pm.environment.get(\"casa\")));",
                  "pm.test(\"Soy arrendataria de A-01\", function () { pm.expect(vinculo).to.exist; });",
                  "pm.environment.set(\"persona\", vinculo.persona);"
                ]
              }
            }
          ]
        },
        {
          "name": "Puntos de mi terreno",
          "metaInfo": {
            "id": "6",
            "type": "http",
            "name": "Puntos de mi terreno"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/puntos-acceso/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"principal\", pm.response.json().find(p => p.codigo === \"N-01\").id);",
                  "pm.environment.set(\"servicio\", pm.response.json().find(p => p.codigo === \"N-02\").id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrar por el portón",
          "metaInfo": {
            "id": "7",
            "type": "http",
            "name": "Entrar por el portón"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/accesos/solicitudes/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medio\": \"app\",\n  \"punto\": \"{{principal}}\",\n  \"cerca\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La API identifica la persona del token\", function () { pm.expect(pm.response.json().persona).to.eql(Number(pm.environment.get(\"persona\"))); });",
                  "pm.test(\"Decisión para este punto\", function () { pm.expect(pm.response.json().permitido).to.eql(true); });",
                  "pm.test(\"Motivo\", function () { pm.expect(pm.response.json().motivo).to.eql(\"autorizado\"); });",
                  "pm.environment.set(\"alta\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Intentar la puerta de servicio",
          "metaInfo": {
            "id": "8",
            "type": "http",
            "name": "Intentar la puerta de servicio"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/accesos/solicitudes/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medio\": \"app\",\n  \"punto\": \"{{servicio}}\",\n  \"cerca\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La API identifica la persona del token\", function () { pm.expect(pm.response.json().persona).to.eql(Number(pm.environment.get(\"persona\"))); });",
                  "pm.test(\"Decisión para este punto\", function () { pm.expect(pm.response.json().permitido).to.eql(false); });",
                  "pm.test(\"Motivo\", function () { pm.expect(pm.response.json().motivo).to.eql(\"sin_permiso_punto\"); });",
                  "pm.environment.set(\"baja\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Asignar como residente",
          "metaInfo": {
            "id": "9",
            "type": "http",
            "name": "Asignar como residente"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/{{casa}}/asignaciones/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"persona\": \"{{persona}}\",\n  \"rol\": \"conviviente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi historial",
          "metaInfo": {
            "id": "10",
            "type": "http",
            "name": "Mi historial"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/historial/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const ids = pm.response.json().map(i => i.id);",
                  "pm.test(\"Ambos intentos quedaron registrados\", function () { pm.expect(ids).to.include.members([Number(pm.environment.get(\"alta\")), Number(pm.environment.get(\"baja\"))]); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
