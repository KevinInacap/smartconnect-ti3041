{
  "apidogCli": "1.1",
  "info": {
    "name": "SmartConnect · Acceso residencial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "environment": {
    "name": "SmartConnect local",
    "variable": {
      "values": [
        {
          "key": "baseUrl",
          "value": "http://127.0.0.1:8000"
        }
      ]
    }
  },
  "item": [
    {
      "name": "Acceso de una residente",
      "item": [
        {
          "name": "Viviendas sin sesión",
          "metaInfo": {
            "id": "1",
            "type": "http",
            "name": "Viviendas sin sesión"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "metaInfo": {
            "id": "2",
            "type": "http",
            "name": "Iniciar sesión"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/token/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"aula_scarlett\",\n  \"password\": \"Scarlett-Aula-TI3041!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "for (const clave of [\"access\", \"refresh\", \"terreno_residente\", \"casa_residente\", \"persona\", \"principal\", \"servicio\", \"alta\", \"baja\"]) { pm.environment.unset(clave); }",
                  "if (pm.response.code === 200) {",
                  "  const tokens = pm.response.json();",
                  "  pm.test(\"El login entrega ambos tokens\", function () { pm.expect(tokens).to.include.all.keys(\"access\", \"refresh\"); });",
                  "  pm.environment.set(\"access\", tokens.access);",
                  "  pm.environment.set(\"refresh\", tokens.refresh);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar sesión",
          "metaInfo": {
            "id": "3",
            "type": "http",
            "name": "Renovar sesión"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/token/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.environment.set(\"access\", pm.response.json().access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi terreno",
          "metaInfo": {
            "id": "11",
            "type": "http",
            "name": "Mi terreno"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/terrenos/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const norte = pm.response.code === 200 && pm.response.json().find(t => t.codigo === \"norte\");",
                  "pm.test(\"Veo Parque Norte\", function () { pm.expect(norte && norte.id).to.be.a(\"number\"); });",
                  "if (norte) pm.environment.set(\"terreno_residente\", norte.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis viviendas",
          "metaInfo": {
            "id": "4",
            "type": "http",
            "name": "Mis viviendas"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const norte = Number(pm.environment.get(\"terreno_residente\"));",
                  "const casa = pm.response.code === 200 && pm.response.json().find(v => v.codigo === \"A-01\" && v.terreno === norte);",
                  "pm.test(\"A-01 pertenece a Parque Norte\", function () { pm.expect(casa && casa.id).to.be.a(\"number\"); });",
                  "if (casa) pm.environment.set(\"casa_residente\", casa.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi rol en A-01",
          "metaInfo": {
            "id": "5",
            "type": "http",
            "name": "Mi rol en A-01"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/{{casa_residente}}/asignaciones/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const vinculos = pm.response.code === 200 ? pm.response.json() : [];",
                  "const vinculo = vinculos.find(v => v.rol === \"arrendatario\" && v.vivienda === Number(pm.environment.get(\"casa_residente\")));",
                  "pm.test(\"Solo veo mi vínculo de arrendataria en A-01\", function () {",
                  "  pm.expect(vinculos).to.have.lengthOf(1);",
                  "  pm.expect(vinculo && vinculo.persona).to.be.a(\"number\");",
                  "});",
                  "if (vinculo) pm.environment.set(\"persona\", vinculo.persona);"
                ]
              }
            }
          ]
        },
        {
          "name": "Puntos de mi terreno",
          "metaInfo": {
            "id": "6",
            "type": "http",
            "name": "Puntos de mi terreno"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/puntos-acceso/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const norte = Number(pm.environment.get(\"terreno_residente\"));",
                  "const puntos = pm.response.code === 200 ? pm.response.json().filter(p => p.terreno === norte) : [];",
                  "const principal = puntos.find(p => p.codigo === \"N-01\");",
                  "const servicio = puntos.find(p => p.codigo === \"N-02\");",
                  "pm.test(\"Veo N-01 y N-02 de Parque Norte\", function () {",
                  "  pm.expect(principal && principal.id).to.be.a(\"number\");",
                  "  pm.expect(servicio && servicio.id).to.be.a(\"number\");",
                  "});",
                  "if (principal && servicio) {",
                  "  pm.environment.set(\"principal\", principal.id);",
                  "  pm.environment.set(\"servicio\", servicio.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrar por el portón",
          "metaInfo": {
            "id": "7",
            "type": "http",
            "name": "Entrar por el portón"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/accesos/solicitudes/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medio\": \"app\",\n  \"punto\": \"{{principal}}\",\n  \"cerca\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La API identifica la persona del token\", function () { pm.expect(pm.response.json().persona).to.eql(Number(pm.environment.get(\"persona\"))); });",
                  "pm.test(\"Decisión para este punto\", function () { pm.expect(pm.response.json().permitido).to.eql(true); });",
                  "pm.test(\"Motivo\", function () { pm.expect(pm.response.json().motivo).to.eql(\"autorizado\"); });",
                  "pm.environment.set(\"alta\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Intentar la puerta de servicio",
          "metaInfo": {
            "id": "8",
            "type": "http",
            "name": "Intentar la puerta de servicio"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/accesos/solicitudes/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medio\": \"app\",\n  \"punto\": \"{{servicio}}\",\n  \"cerca\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La API identifica la persona del token\", function () { pm.expect(pm.response.json().persona).to.eql(Number(pm.environment.get(\"persona\"))); });",
                  "pm.test(\"Decisión para este punto\", function () { pm.expect(pm.response.json().permitido).to.eql(false); });",
                  "pm.test(\"Motivo\", function () { pm.expect(pm.response.json().motivo).to.eql(\"sin_permiso_punto\"); });",
                  "pm.environment.set(\"baja\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Asignar como residente",
          "metaInfo": {
            "id": "9",
            "type": "http",
            "name": "Asignar como residente"
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/viviendas/{{casa_residente}}/asignaciones/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"persona\": \"{{persona}}\",\n  \"rol\": \"conviviente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi historial",
          "metaInfo": {
            "id": "10",
            "type": "http",
            "name": "Mi historial"
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access}}"
              }
            ],
            "url": "{{baseUrl}}/api/historial/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const ids = pm.response.json().map(i => i.id);",
                  "pm.test(\"Ambos intentos quedaron registrados\", function () { pm.expect(ids).to.include.members([Number(pm.environment.get(\"alta\")), Number(pm.environment.get(\"baja\"))]); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
