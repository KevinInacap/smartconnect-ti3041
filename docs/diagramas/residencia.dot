digraph Residencia {
  graph [bgcolor="#F7FAFC", pad="0.25", nodesep="0.4", ranksep="0.5", outputorder=edgesfirst];
  node [shape=plain, fontname="Arial", fontsize=12, fontcolor="#21354B"];
  edge [fontname="Arial", fontsize=11, color="#54718A", fontcolor="#29465F", penwidth=1.4, arrowsize=0.7];

  cuenta [label=<
    <TABLE BORDER="1" COLOR="#B9C7D3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD BGCOLOR="#1A3651" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>Cuenta Django</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">PK id · UQ username</TD></TR>
      <TR><TD ALIGN="LEFT"><B>is_staff</B> · ¿opera el catálogo global?</TD></TR>
      <TR><TD ALIGN="LEFT">Sí: operador  /  No: cuenta estándar</TD></TR>
    </TABLE>>];
  persona [label=<
    <TABLE BORDER="1" COLOR="#B9C7D3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD BGCOLOR="#135F5B" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>Persona</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">PK id · UQ codigo · nombre</TD></TR>
      <TR><TD ALIGN="LEFT">FK única cuenta_id (opcional)</TD></TR>
    </TABLE>>];
  terreno [label=<
    <TABLE BORDER="1" COLOR="#B9C7D3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD BGCOLOR="#135F5B" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>Terreno</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">PK id · UQ codigo · nombre</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK administrador_id</B> → Persona</TD></TR>
    </TABLE>>];
  vivienda [label=<
    <TABLE BORDER="1" COLOR="#B9C7D3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD BGCOLOR="#135F5B" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>Vivienda</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">PK id · FK terreno_id</TD></TR>
      <TR><TD ALIGN="LEFT">codigo · tipo (casa o departamento)</TD></TR>
    </TABLE>>];
  empleo [label=<
    <TABLE BORDER="1" COLOR="#B9C7D3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD BGCOLOR="#31547A" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>Empleo</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">FK persona_id · FK terreno_id</TD></TR>
      <TR><TD ALIGN="LEFT">UQ (persona, terreno)</TD></TR>
    </TABLE>>];
  participacion [label=<
    <TABLE BORDER="1" COLOR="#B9C7D3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white">
      <TR><TD BGCOLOR="#31547A" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="16"><B>Participación en vivienda</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT">FK persona_id · FK vivienda_id</TD></TR>
      <TR><TD ALIGN="LEFT">UQ (persona, vivienda)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>rol</B> · propietario administrador,</TD></TR>
      <TR><TD ALIGN="LEFT">propietario, arrendatario o conviviente</TD></TR>
    </TABLE>>];
  cuenta -> persona [label="  0..1 ↔ 0..1  "];
  persona -> terreno [label=" 1 administra 0..N "];
  terreno -> vivienda [label=" 1 contiene 0..N "];
  persona -> participacion [label=" 1 tiene 0..N "];
  vivienda -> participacion [label=" 1 reúne 0..N "];
  persona -> empleo [label=" 1 tiene 0..N "];
  terreno -> empleo [label=" 1 registra 0..N "];
}
